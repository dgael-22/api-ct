# Proxy de salida con IP fija hacia CT Online.
#
# CT sólo acepta llamadas desde IPs registradas y Railway (plan Hobby) no tiene
# IP fija. La API llama aquí con la cabecera X-Proxy-Key; Caddy la valida, la
# quita y reenvía la petición a CT, que la ve llegar desde la IP de este Droplet.
#
# instalar.sh reemplaza __DOMINIO__ y __CLAVE_PROXY__ al copiarlo a /etc/caddy.

__DOMINIO__ {
	# Los handle son excluyentes: primero la ruta exacta, luego el de la
	# cabecera y al final el que no tiene condición.

	# Para monitoreo: no toca a CT ni necesita clave.
	handle /__proxy/salud {
		respond "ok" 200
	}

	@autorizado header X-Proxy-Key "__CLAVE_PROXY__"
	handle @autorizado {
		reverse_proxy https://api.ctonline.mx {
			header_up Host {upstream_hostport}
			# Ni la clave ni las IPs de Railway salen hacia CT.
			header_up -X-Proxy-Key
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
		}
	}

	# Cualquier otra cosa: nadie más usa esta IP.
	handle {
		respond "forbidden" 403
	}

	log {
		output file /var/log/caddy/proxy-ct.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
