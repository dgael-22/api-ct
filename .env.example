# Variables de entorno del middleware (sección 11.1 del ETS).
# Copiar a .env y poner los valores reales. El .env NUNCA entra a Git.
#
# En Railway estas mismas variables se ponen en Variables del servicio, NO en
# un archivo: ahí PORT y DATABASE_URL las inyecta la plataforma sola.

PORT=3000
# Clave de los endpoints de gestión (/mappings, /inventory, /orders): va en la
# cabecera x-api-key. Sin ella esos endpoints responden 503. Generar una larga:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=replace_me
# URL pública del servicio. En Railway se deduce de RAILWAY_PUBLIC_DOMAIN y
# esta línea no hace falta.
APP_BASE_URL=https://tu-url-publica

# ---- Shopify ------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=tienda.myshopify.com
# Del Dev Dashboard: tu app -> Settings. Con estos dos el middleware pide el
# token solo (dura 24 h y se renueva automáticamente).
SHOPIFY_CLIENT_ID=replace_me
SHOPIFY_CLIENT_SECRET=replace_me
SHOPIFY_API_VERSION=2025-07
# OPCIONAL: sólo si tienes un token permanente (shpat_...) de una app vieja
# creada en el admin. Si lo pones, se usa ése y no se pide ninguno.
# SHOPIFY_ACCESS_TOKEN=shpat_...
# Secreto con el que Shopify firma los webhooks
SHOPIFY_WEBHOOK_SECRET=replace_me
# Location de Shopify sobre la que se fija el inventario
SHOPIFY_LOCATION_ID=replace_me

# ---- CT Online ----------------------------------------------------------
# "real" habla con CT; "simulado" usa el CT de mentiras para probar el circuito
# completo sin esperar a que CT autorice la integración.
CT_MODO=real
# Sólo en modo simulado: ok | sin_stock | rechazo | caida
CT_SIMULADO_ESCENARIO=ok

# CT sólo acepta IPs registradas. En producción las llamadas salen por el
# proxy con IP fija (deploy/proxy): CT_BASE_URL apunta al proxy y
# CT_PROXY_KEY es su clave. En local, directo a CT y sin clave.
CT_BASE_URL=https://api.ctonline.mx
# CT_PROXY_KEY=replace_me
CT_ACCESS_TOKEN=replace_me
# Credenciales para emitir el token (POST /cliente/token)
CT_EMAIL=replace_me
CT_CLIENTE=replace_me
CT_RFC=replace_me
# Almacén de CT que surte. PENDIENTE de confirmar con CT.
CT_ALMACEN=replace_me

# ---- Base de datos ------------------------------------------------------
# Local:
DATABASE_URL=sqlite:./data/schu-ct.sqlite
# Railway / producción: la plataforma inyecta la URL de PostgreSQL.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# SSL hacia PostgreSQL. Por la red interna de Railway
# (postgres.railway.internal) va en false; por la URL pública, en true.
DB_SSL=false

# ---- Confirmación automática de pedidos ---------------------------------
# Minutos entre pasadas. 0 = apagado (en local se corre a mano con
# `npm run confirm:orders`). En Railway conviene 15: CT cancela por su cuenta
# cualquier pedido que no se confirme dentro de su ventana de 48 h.
CONFIRM_INTERVAL_MINUTES=0

# ---- Sincronización de existencias ----------------------------------------
# Minutos entre pasadas CT -> Shopify para los mapeos confirmados. 0 = apagado.
# En producción, 60 es razonable. Una consulta por producto, separadas por
# CT_PAUSA_MS; si CT responde 429 la pasada se corta.
INVENTORY_SYNC_MINUTES=0
CT_PAUSA_MS=1000

# ---- Bitácora --------------------------------------------------------------
# Días que se guardan los eventos (GET /bitacora). 0 = para siempre.
BITACORA_DIAS=365
