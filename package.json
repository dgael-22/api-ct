{
  "name": "schu-ct-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Middleware de integración SCHU – Shopify – CT Online (MVP del ETS)",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "migration:run": "tsx src/scripts/runMigrations.ts",
    "inspect:csv": "tsx src/scripts/inspectCsv.ts",
    "import:mappings": "tsx src/scripts/importConfirmedMappings.ts",
    "sync:inventory": "tsx src/scripts/syncInventory.ts",
    "confirm:orders": "tsx src/scripts/confirmOrders.ts"
  },
  "dependencies": {
    "@shopify/shopify-api": "^11.6.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
